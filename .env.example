LITHOPS_STORAGE_BACKEND=memory
SUPABASE_URL=
SUPABASE_SECRET_KEY=
LITHOPS_BENCHMARK_BACKEND=fake

# Required only when LITHOPS_BENCHMARK_BACKEND=ceobench.
# On Windows set CEOBENCH_PYTHON to a Python 3.13+ executable.
CEOBENCH_EXECUTABLE=
CEOBENCH_PYTHON=
CEOBENCH_SEED=42

# Model provider used by the Executive: static, openrouter, or gemini.
LITHOPS_MODEL_PROVIDER=static
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-32b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Enable after applying the executable-model registry migration.
LITHOPS_EXECUTABLE_MODEL_PLANNING=false

# Google Cloud Model Armor screening of environment-authored text (inbox, social,
# announcements) before it reaches the executive brief. off | monitor | enforce.
# monitor records verdicts on the event ledger; enforce also redacts flagged fields.
LITHOPS_MODEL_ARMOR=off
LITHOPS_MODEL_ARMOR_TEMPLATE=

# OpenTelemetry tracing of the weekly reasoning chain, exported to Cloud Trace.
LITHOPS_TRACING=off
