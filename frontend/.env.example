# Base URL of the Lithops API. Defaults to http://127.0.0.1:8000.
VITE_API_URL=http://127.0.0.1:8000

# Run the landing page replays when a visitor presses RUN SIMULATION.
# Leave empty to fall back to the last run viewed in this browser, and to
# offer CREATE FRESH RUN when there is none.
VITE_DEMO_RUN_ID=
